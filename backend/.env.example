# ─── Database ──────────────────────────────────────────────────────────────────
# Direct SQLite URL for local dev (leave empty to use PostgreSQL)
DATABASE_URL=sqlite:///./meetai.db

# PostgreSQL (used if DATABASE_URL is not set)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=meeting_assistant

# ─── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ─── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
SIMILARITY_THRESHOLD=0.85

# ─── Email (Gmail SMTP - optional, auto-verifies in dev if empty) ──────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
FRONTEND_URL=http://localhost:5173

# ─── LiveKit WebRTC ───────────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
